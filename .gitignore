# Dependencies and build caches
node_modules/
dist/
.astro/
.cache/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example
!.env.*.example
# 私钥及带私钥的证书容器；公开证书与示例配置不按扩展名一概排除。
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Local tool/editor state
.claude/
.vscode/
.idea/
.mimosa/
# 本地 Agent 沟通、交接与执行清单
/docs/superpowers/
/docs/BLOG_RELIABILITY_PLAN.md
/docs/assets/spring-ui/
/docs/assets/admin-pearl/
# 测试报告、执行记录和自动截图仅用于本机，不作为维护文档入库。
/docs/testing/

# Deploy / build-on-publish artifacts (admin backend)
releases/
current
.build-lock/
dist-*/
.content-build-manifest.json
.test-tmp-*/
.test-tmp/
.current-tmp
.current-old

# Test output only: keep tests/, scripts/ and reusable fixture source tracked.
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/

# Interrupted atomic writes and editor scratch files (not source data).
*.tmp
*.swp
*.swo
*~

# 个人博客数据：内容与媒体不进仓库（详见 docs/DEPLOYMENT.md「数据备份与恢复」）
src/content/
public/uploads/
# 官方 SDK 由 Astro 配置从锁定的 npm 依赖同步，避免重复提交第三方压缩产物。
/public/vendor/twikoo-*.js
/public/vendor/twikoo-*.LICENSE.txt
# 本机私人壁纸仅保留目录，不随源码提交。
public/wallpapers/*
!public/wallpapers/.gitkeep
# 根目录素材源文件（根目录锚定，不影响 public/ 下的运行副本入库）
/profile.jpg
/shubiao.png
# 动态数据默认不入库（个人数据与运行时状态）；仅白名单放行页面基础数据，
# 作为克隆者的默认站点骨架。后台新增的数据文件会保持忽略，需入库时在此显式放行。
# 项目展示数据（projects.json）属个人数据，不入仓库（随数据备份进私库）。
data/*
!data/profile.json
!data/announcements.json

# Logs and OS caches
*.log
*-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini
# 字体源文件：运行副本在 public/fonts/（根目录锚定写法，不影响副本入库）
/LXGWWenKaiMono-Medium.ttf
# subset-font.mjs also accepts this input location and writes a temporary character list.
/public/fonts/LXGWWenKaiMono-Medium.ttf
/public/fonts/.subset-unicodes.txt
